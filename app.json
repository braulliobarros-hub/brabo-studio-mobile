{
  "expo": {
    "name": "Brabo Studio",
    "slug": "brabo-studio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "brabostudio",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "experiments": {
      "baseUrl": "/brabo-studio-mobile"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brabostudio.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050506"
      },
      "package": "com.brabostudio.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050506"
        }
      ]
    ]
  }
}
